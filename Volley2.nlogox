<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.2" snapToGrid="true">
  <code><![CDATA[
breed [ joueurs-dom joueur-dom ]
breed [ joueurs-ext joueur-ext ]
breed [ balles balle ]

globals [ roles service compteur-dom compteur-ext en-jeu revenir-pos? victoire? type-service precision-service puissance-service ]
turtles-own [ role pos puissance taux-precision taux-echec rate? ]
balles-own [ cible nb-passes speed camp precis decalage direction-fixe ]


to setup
  clear-all
  no-display ;; sinon la vue graphique est modifié après chaque agent modifié, ce qui crée des gros ralentissement dans le setup
  
  set roles [ "R1" "R6" "R5" "R4" "R3" "R2" ]
  set service "gauche"
  
  set compteur-dom 0
  set compteur-ext 0
  set en-jeu true
  set revenir-pos? false
  set victoire? false
  set type-service ""
  
  
  ;; Créer le terrain de volley avec les lignes de sorties, de 3 mètres et le filet en blanc
  ask patches [
    if (pxcor >= -30 and pxcor <= 31) and (pycor >= -16 and pycor <= 16) [
      set pcolor blue
    ]
    
    if (pxcor >= -29 and pxcor <= 30) and (pycor >= -15 and pycor <= 15) [
      set pcolor brown
    ]
    
    if(pxcor = -0 and (pycor >= -16 and pycor <= 16)) [
      set pcolor white
      ]
    
    if(pxcor = -10 and (pycor >= -16 and pycor <= 16)) [
      set pcolor blue
    ]
    
    if(pxcor = 10 and (pycor >= -16 and pycor <= 16)) [
      set pcolor blue
    ]
  ]
  
  set-default-shape turtles "person"
  set-default-shape balles "circle"
  
  create-joueurs-dom 6 [
    set color red
    setxy random-xcor random-ycor
    set size 4
    set puissance (random (puissance-max-dom - 19) + 19) ;; pour ne pas avoir de gros écarts
    set taux-echec (random taux-echec-max-dom - 1) + 1
    set taux-precision (random precision-max-dom - 1) + 1
  ]
  
  create-joueurs-ext 6 [
    set color green
    setxy random-xcor random-ycor
    set size 4
    set puissance (random (puissance-max-ext - 10) + 10)
    set taux-echec (random taux-echec-max-ext - 1) + 1
    set taux-precision (random precision-max-ext - 1) + 1
  ]
  
  create-balles 1 [
    set color white
    setxy random-xcor random-ycor
    set size 2
    set cible nobody ;; détermine la cible de la balle (là où elle va aller)
    set nb-passes 0 ;; détermine le nb actuel de passe dans l'équipe
    set camp "gauche" ;; détermine dans quel camp est la balle
    set speed 0.5
  ]
  
  attribuer-roles
  ask joueurs-dom [ placer-dom ]
  ask joueurs-ext [ placer-ext ]
  
  ;; Les libéro sont de couleur distinctive par rapport aux autres joueurs de l'équipe
  ask joueurs-dom with [ role = "R6" ] [ set color pink ]
  ask joueurs-ext with [ role = "R6" ] [ set color yellow ]
  
  ask balles [ move-to one-of joueurs-dom with [role = "R1"] ] ;; on place la balle sur joueur 0
  
  reset-ticks
  display ;; dessine la vue graphique à la fin, donc seulement pour l'état final
end

to victoire
  if (compteur-dom >= 25) and (compteur-dom > compteur-ext + 1) [
    show("Victoire de l'équipe Rouge")
    set victoire? true
  ]
  if (compteur-ext >= 25) and (compteur-ext > compteur-dom + 1) [
    show("Victoire de l'équipe Verte")
    set victoire? true
  ]
end

to celebration [agent-set]
  ask agent-set [
    if (pcolor = brown) or (pcolor = blue) [
      set xcor xcor + random-float 1 - 0.5
      set ycor ycor + random-float 1 - 0.5
    ]
  ]
end

to go
  victoire
  ifelse en-jeu = true [
  if service = "gauche" or service = "droite" [ servir ]
  passer
  
  move-balle
    
  ] [
  changement-service
  set en-jeu true
  ]
  if victoire? [ stop ]
  tick
end





to attribuer-roles ;; parcours la variable globale roles pour attribuer un role à chaque joueur
  let i 0
  while [ i < length roles ] [
      ask joueur-ext (i + 6) [ set role (item i roles) ] ;; les agents 6 à 12 sont les joueurs-ext (role variable commune à tous les joueurs)
      ask joueur-dom i [ set role (item i roles) ]
      set i i + 1
  ]
end


to tourner [dom?] ;; effectueur la rotation de l'équipe en changeant les rôles puis en les replaçant
  let n (length roles)
  ifelse dom? [
    let i 0
    while [ i < n ] [
      ask joueur-dom i [ set role (item (((position ([role] of joueur-dom i) roles) + 1) mod n) roles) ]
      set i i + 1
    ]
    ask joueurs-dom [ placer-dom ]
  ] [ 
    let i 0
    while [ i < n ] [
      ask joueur-ext (i + 6) [ set role (item (((position ([role] of joueur-ext (i + 6)) roles) + 1) mod n) roles) ]
      set i i + 1
    ]
    ask joueurs-ext [ placer-ext ]
  ] 
end

to-report determiner-joueur [num]
  if (num = 0) or (num = 6) [
    report "R1"
  ]
  if (num = 1) or (num = 7) [
    report "R6"
  ]
  if (num = 2) or (num = 8) [
    report "R5"
  ]
  if (num = 3) or (num = 9) [
    report "R4"
  ]
  if (num = 4) or (num = 10) [
    report "R3"
  ]
  if (num = 5) or (num = 11) [
    report "R2"
  ]
end

;; Permet de placer les joueurs de gauche
to placer-dom
  if role = "R3" [ set pos (patch -7 0) move-to pos ]
  if role = "R4" [ set pos (patch -10 9) move-to pos ]
  if role = "R2" [ set pos (patch -10 -9) move-to pos ]
  if role = "R6" [ set pos (patch -20 0) move-to pos ]
  if role = "R5" [ set pos (patch -22 9) move-to pos ]
  if role = "R1" [ set pos (patch -22 -9) move-to pos ]
end

;; Permet de placer les joueurs de droite
to placer-ext
  if role = "R3" [ set pos (patch 7 0) move-to pos ]
  if role = "R2" [ set pos (patch 10 9) move-to pos ]
  if role = "R4" [ set pos (patch 10 -9) move-to pos ]
  if role = "R6" [ set pos (patch 20 0) move-to pos ]
  if role = "R1" [ set pos (patch 22 9) move-to pos ]
  if role = "R5" [ set pos (patch 22 -9) move-to pos ]
end

;; Fonction qui détermine si le joueur renvoie la balle ou non
to rater [joueur agent-set]
  
  ;; Reception
  let echec random 100
  let dec [decalage] of one-of agent-set
  let speed-balle [speed] of one-of agent-set
  
    ;; Cas où le joueur rate sa reception
  ifelse echec < ( ([taux-echec] of joueur + 1.5 * (abs dec)) * (speed-balle) ) [
      set rate? true
      set nb-passes 0
    
    ] [
      set rate? false
    ]
  
end

to changement-service
  ask balles [
    set speed 0.5
    set decalage 0
    ifelse camp = "gauche" [
      if service = "finiG" [
        tourner false
      ]
      
      move-to one-of joueurs-ext with [role = "R1"]
      set camp "droite"
      set service "droite"
      set compteur-ext compteur-ext + 1
      
      
    ]
    [
      if service = "finiD" [
        tourner true
      ]
      move-to one-of joueurs-dom with [role = "R1"]
      set camp "gauche"
      set service "gauche"
      set compteur-dom compteur-dom + 1
    ]
    
  ]
end

to servir
  
  ;; Déclaration de qqes variables pour la variation de service
  let chance-type-service-smashe 0
  let chance-type-service-normal 0 
  let chance-type-service-flotant 0 
  
  
    
  
  ;; Déclaration de variable pour le service
  let serveur nobody
  let pos-serveur patch 0 0 
  let pos-contact patch 0 0
  let chance-passe 0
  let receveur nobody
  

  
  ;; ------------------------------------- Faire un type de service selon la préférence du joueur - "smashe" "normal" ou "flotant" -------------------------------------------
  
  ;; Définir les serveurs
  if service = "gauche" [ 
    set serveur one-of joueurs-dom with [role = "R1"]
    set chance-type-service-smashe  chance-service-smashe-dom
    set chance-type-service-flotant random 100 + chance-type-service-smashe
  ]
  if service = "droite" [ 
    set serveur one-of joueurs-ext with [role = "R1"]
    set chance-type-service-smashe  chance-service-smashe-ext
    set chance-type-service-flotant random 100 + chance-type-service-smashe
  ]
  
  let puissance-initiale [puissance] of serveur
  
  
  let chance-type-service random 100
  if chance-type-service <= chance-type-service-smashe [ set type-service "smashe" ]
  if chance-type-service > chance-type-service-smashe and chance-type-service <= chance-type-service-flotant [ set type-service "flotant" ]
  if chance-type-service > chance-type-service-flotant [ set type-service "normal" ]

  
  
  
    
  
  ;; Vérifier si le service est à gauche ou à droite
  if service = "gauche" [
    if type-service = "smashe" [
      set pos-serveur patch -47 -9
      set pos-contact patch -37 -9
    ]
    
    if type-service = "normal" [
      set pos-serveur patch -34 -9
      set pos-contact patch -32 -9
    ]
    
    if type-service = "flotant" [
      set pos-serveur patch -40 -9
      set pos-contact patch -32 -9
    ]
    
    set chance-passe random 2 ;; Renvoie un nombre entre 0 et 2 qui correspond à un des trois joueurs de la ligne défensive
    set receveur one-of joueurs-ext with [role = (determiner-joueur chance-passe)]
  ]
  
  if service = "droite" [
    
    if type-service = "smashe" [
      set pos-serveur patch 47 9
      set pos-contact patch 37 9
      
      ask serveur [ set puissance (puissance + 60) ]
    ]
    
    if type-service = "normal" [
      set pos-serveur patch 34 9
      set pos-contact patch 32 9
    ]
    
    if type-service = "flotant" [
      set pos-serveur patch 40 9
      set pos-contact patch 32 9
    ]
    
    set chance-passe random 2 ;; Renvoie un nombre entre 0 et 2 qui correspond à un des trois joueurs de la ligne défensive
    set receveur one-of joueurs-dom with [role = (determiner-joueur chance-passe)]
  ]
  
  
    
    
    ;; Partie 1 -> amener le joueur sur le patch pour servir avec la balle
    ask serveur [
      while [distance pos-serveur > 0.5] [
        face pos-serveur
        fd 0.5
        set pos patch-here   ;; Remettre à jour la position du joueur
        
        ask balles [ 
        set cible serveur
        definir-direction
        ]
        
        move-balle
      ]
      ;; bien mettre les agents sur le bon patch quand ils sont proches de ce dernier
      move-to pos-serveur
      ask balles [ move-to pos-serveur ]
    
    ]
    
    
    ;; Partie 2 -> lancer de la balle 
    ask balles [
      set speed 0.25 ;; La balle va moins vite, il s'agit d'un lancer en cloche
      while [distance pos-contact > 0.2] [
        
        face pos-contact
        fd speed
        
        if distance pos-contact < 5 [ ;; Le serveur commence sa course d'élan pour le service à moitié de distance du lancer de balle
          ask serveur [
            face pos-contact 
            fd 0.5
          ]
        ]
      ]
    ]
    
    
    vitesse-balle serveur ;; ajuste la vitesse du serveur
    precision-balle serveur
    decalage-balle
    
    ;; Partie 3 -> contact avec la balle
    ask balles [
      set cible receveur
    
      definir-direction
    
      if service = "gauche" [
         set camp "droite"
         set service "finiG"
      ]
    
    if service = "droite" [
         set camp "gauche"
         set service "finiD"
      ]
    
    
    ]
    
    ask serveur [ 
    if service = "finiG" [ set pos (patch -22 -9) ]
    if service = "finiD" [ set pos (patch 22 9) ]
    set puissance (puissance-initiale)
      while [ distance pos > 0.3 ] [
        face pos
        fd 0.3
        move-balle
      ]
      move-to pos
    ]
  set type-service ""
 
 
end

to definir-direction
  face [pos] of cible
  right decalage
  set direction-fixe heading   ;; <— ANGLE FIGÉ
end
  
;; Determiner sur quel joueur va aller la balle
to passer
  ask balles [
    let porteur one-of other turtles-here
    if porteur != nobody and cible = nobody [
      vitesse-balle porteur
      precision-balle porteur
      decalage-balle
      
      rater porteur balles
      show (word "Le taux d'échec du porteur: " [taux-echec] of porteur)
      
      ifelse rate? = false [
        passer-adversaire ;; vérifie si le nb de passes max est effectué pour envoyer la balle dans le camp adverse
        ;; Reception des joueurs arrière -> passe au passeur R3
        if [role] of porteur = "R1" or [role] of porteur = "R6" or [role] of porteur = "R5" [
          passer-passeur
        ]

        ;; Passe la balle a l'attaquant avec proba = 0.5
        if [role] of porteur = "R3" [
            passer-attaquant
        ]
      ]
      [ set speed 0
        set en-jeu false ]
      
      ask porteur [ revenir-position ]
    ]
  ]
end


;; Fonction qui passe la balle au passeur
to passer-passeur
  ask balles [ ;; Perspective de la balle
    ifelse camp = "gauche" [
      let receveur one-of joueurs-dom with [role = "R3"]
      set cible receveur
      definir-direction
      set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
    ] [
      let receveur one-of joueurs-ext with [role = "R3"]
      set cible receveur
      definir-direction
      set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
    ]

  ]
end
  
;; Fonction qui permet à la balle de changer de camp en attaquant
to passer-adversaire
  ;; Permet de renvoyer la balle dans le camp adverse ( aux joueurs défensifs )
      let chance-passe random 2 ;; Renvoie un nombre entre 0 et 2 qui correspond à un des trois joueurs de la ligne défensive
  
      if nb-passes >= 2 and camp = "gauche" [
        let receveur one-of joueurs-ext with [role = (determiner-joueur chance-passe)] ;; Les joueurs 6 à 8 sont les joueurs défensifs des joueurs extérieurs
        set cible receveur
        definir-direction
        set nb-passes 0
        set camp "droite" ;; La balle est mtn dans le camp droite
      ]
      
      if nb-passes >= 2 and camp = "droite" [
        let receveur one-of joueurs-dom with [role = (determiner-joueur chance-passe)]
        set cible receveur
        definir-direction
        set nb-passes 0
        set camp "gauche"
      ]
end


;; Fonction qui determine l'attaquant
to passer-attaquant
  ask balles [
    
    ;; Par rapport au camp de gauche
    ifelse camp = "gauche" [
        let chance-passe random-float  1
        ifelse chance-passe < 0.5 [
           let receveur one-of joueurs-dom with [role = "R2"]
           set cible receveur
           definir-direction
           set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
      ] [
           let receveur one-of joueurs-dom with [role = "R4"]
           set cible receveur
           definir-direction
           set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
         ]
    ] 
    
    ;; Par rapport au camp de droite
    [
          let chance-passe random-float  1
          ifelse chance-passe < 0.5 [
          let receveur one-of joueurs-ext with [role = "R2"]
          set cible receveur
          definir-direction
          set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
       ] [
          let receveur one-of joueurs-ext with [role = "R4"]
          set cible receveur
          definir-direction
          set nb-passes nb-passes + 1 ;; Incrementer le nombre de passe
        
        
        ]
    ]
  ]
end

to decalage-balle 
  ask balles [
    let erreur-max erreur-max-base * (1 - (precis / 100))
    set decalage (random-float (2 * erreur-max) - erreur-max)
  ]
end

;; Fonction qui détermine la vitesse de la balle pour chaque joueur (à mettre dans un ask joueur) en fonction de la puissance
to vitesse-balle [joueur]
  ask balles [
    set speed (speed * (1 + ([puissance] of joueur) * 0.01 )) ;; vitesse propre à chaque joueur
    ifelse ([role] of joueur = "R4") or ([role] of joueur = "R2") [
      set speed (speed + 0.5) ;; augmentation de la vitesse pour les attaquants
    ] [
      ifelse (service != "finiG" or service != "finiD") and [role] of joueur = "R1" [
        if (type-service = "smashe") [
          set speed (speed + 0.8) ;; augmentation de la vitesse pour le serveur
        ]
          
        if (type-service = "flotant") [
          set speed (speed + 0.5) ;; augmentation de la vitesse pour le serveur
        ]
            
         if (type-service = "normal") [
          set speed (speed + 0.3) ;; augmentation de la vitesse pour le serveur
        ]
              
      ] [
        set speed (0.5 * (1 + ([puissance] of joueur) * 0.01 )) ;; sinon revient à la vitesse propre du joueur
      ]
    ]
  ]
end
    
to precision-balle [joueur]
  ask balles [
    ifelse ((service != "finiG" and service != "finiD") and [role] of joueur = "R1") [
      
      set precis [taux-precision] of joueur
      
      if type-service = "smashe" [
        if precis < 80 [
          set precis precis + 15
        ]
      ]
      
      if type-service = "flotant" [
        if precis > 50 [
          set precis precis - 30
        ]
      ]
      
      if type-service = "normal" [
        if precis > 50 [
          set precis precis - 50
        ]
      ]
      
    ] [
      set precis [taux-precision] of joueur
    ]
  ]
end

to revenir-position
  while [ distance pos > 0.3 ] [
    face pos
    fd 0.3
    move-balle
  ]
  move-to pos
end
  
;; Fonction qui bouge la balle par rapport a sa cible 
to move-balle
  ask balles [
    if cible != nobody [
      let d distance [pos] of cible
      ;; Rayon perception et rayon contact (le receveur commence à bouger quand la balle est dans son rayon de perception (si la balle arrive avant lui c'est point perdu)
      if d > 0 [
        
        if (d < rayon-perception) and (service = "finiG" or service = "finiD") [
          ask cible [
            face one-of balles
            fd 0.5
          ]
          if distance cible < rayon-contact [
            move-to cible
            set speed 0
            set cible nobody
          ]
        ]
        
        
        ;; Calculer l'erreur max pour cette balle selon la précision du porteur*
        set heading direction-fixe
        
        ;; -- AJOUT : Zigzag pour service flottant --
        if type-service = "flotant" [
          set heading (heading + (random-float 60 - 30))   ;; petits zigzags
        ]
        
        fd speed
      ]
      if (service = "gauche" or service = "droite") and (distance [pos] of cible < speed + 0.1) [
        
        move-to [pos] of cible  ;; la balle va sur le patch du receveur quand le rayon de perception du receveur voit la balle
        set cible nobody  
      ]
    ]
  ]
end
]]></code>
  <widgets>
    <view x="490" wrappingAllowedX="false" y="5" frameRate="30.0" minPycor="-25" height="668" showTickCounter="true" patchSize="12.0" fontSize="10" wrappingAllowedY="false" width="1320" tickCounterLabel="ticks" maxPycor="25" updateMode="0" maxPxcor="50" minPxcor="-50"></view>
    <slider x="20" step="5" y="105" max="100" width="165" display="puissance-max-dom" height="50" min="20" direction="Horizontal" default="60.0" variable="puissance-max-dom"></slider>
    <slider x="310" step="5" y="105" max="100" width="150" display="puissance-max-ext" height="50" min="20" direction="Horizontal" default="65.0" variable="puissance-max-ext"></slider>
    <button x="265" y="45" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <button x="175" y="45" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="66">setup
</button>
    <slider x="310" step="1" y="170" max="100" width="150" display="precision-max-ext" height="50" min="0" direction="Horizontal" default="46.0" variable="precision-max-ext"></slider>
    <slider x="20" step="1" y="170" max="100" width="165" display="precision-max-dom" height="50" min="0" direction="Horizontal" default="26.0" variable="precision-max-dom"></slider>
    <monitor x="355" precision="17" y="40" height="60" fontSize="11" width="100" display="     Exterieur">compteur-ext</monitor>
    <slider x="20" step="1" y="235" max="100" width="165" display="taux-echec-max-dom" height="50" min="0" direction="Horizontal" default="0.0" variable="taux-echec-max-dom"></slider>
    <slider x="310" step="1" y="235" max="100" width="150" display="taux-echec-max-ext" height="50" min="0" direction="Horizontal" default="0.0" variable="taux-echec-max-ext"></slider>
    <monitor x="45" precision="17" y="40" height="60" fontSize="11" width="100" display="     Domicile">compteur-dom</monitor>
    <note x="50" y="10" backgroundDark="-2674135" fontSize="12" width="95" markdown="false" height="25" textColorDark="-1" textColorLight="-16777216" backgroundLight="16711680">Equipe domicile</note>
    <note x="350" y="10" backgroundDark="-13840069" fontSize="12" width="95" markdown="false" height="25" textColorDark="-1" textColorLight="-16777216" backgroundLight="65305">Equipe extérieur</note>
    <slider x="20" step="1" y="295" max="100" width="200" display="chance-service-smashe-dom" height="50" min="0" direction="Horizontal" default="50.0" variable="chance-service-smashe-dom"></slider>
    <slider x="265" step="1" y="295" max="100" width="195" display="chance-service-smashe-ext" height="50" min="0" direction="Horizontal" default="49.0" variable="chance-service-smashe-ext"></slider>
    <slider x="120" step="1" y="390" max="30" width="250" display="erreur-max-base" height="50" min="0" direction="Horizontal" default="7.0" variable="erreur-max-base"></slider>
    <slider x="120" step="1" y="450" max="20" width="250" display="rayon-perception" height="50" min="0" direction="Horizontal" default="15.0" variable="rayon-perception"></slider>
    <slider x="125" step="1" y="510" max="10" width="250" display="rayon-contact" height="50" min="1" direction="Horizontal" default="4.0" variable="rayon-contact"></slider>
  </widgets>
  <info>## WHAT IS IT?

(a general understanding of what the model is trying to show or explain)

## HOW IT WORKS

(what rules the agents use to create the overall behavior of the model)

## HOW TO USE IT

(how to use the model, including a description of each of the items in the Interface tab)

## THINGS TO NOTICE

(suggested things for the user to notice while running the model)

## THINGS TO TRY

(suggested things for the user to try to do (move sliders, switches, etc.) with the model)

## EXTENDING THE MODEL

(suggested things to add or change in the Code tab to make the model more complicated, detailed, accurate, etc.)

## NETLOGO FEATURES

(interesting or unusual features of NetLogo that the model uses, particularly in the Code tab; or where workarounds were needed for missing features)

## RELATED MODELS

